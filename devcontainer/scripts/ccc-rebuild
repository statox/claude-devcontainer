#!/bin/bash
# Rebuild the workspace agent container and its image.
# Picks up Dockerfile and compose changes.
#
# Usage: run from the project directory, no arguments.
# Opens a shell in the new container.
set -euo pipefail

source "$CLAUDE_DEVCONTAINER_HOME/devcontainer/scripts/lib/env.sh"

# Create files the container expects on the host
[ -e "$HOME/.claude.json" ] || echo "{}" > "$HOME/.claude.json"
[ -e "$HOME/.netrc" ] || touch "$HOME/.netrc"

# Start the global singleton services. Idempotent.
echo "Start up singleton services"
# shellcheck disable=SC2086
$COMPOSE_CMD -f "$COMPOSE_FILE" up $COMPOSE_UP_FLAGS

# Rebuild the image and recreate the container
echo "Rebuild agent container"
# shellcheck disable=SC2086
$COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" up -d --build --force-recreate $COMPOSE_UP_FLAGS

echo "Provision agent container"
# System packages install as root
$COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" exec -u root agent /usr/local/sbin/provision-root.sh
$COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" exec agent /home/dev/provision.sh

echo "Containers recreated use ccc to start"
exec $COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" exec agent bash
