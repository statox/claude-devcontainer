#!/bin/bash
# ccc - Claude Code Containerized
# Launches (or attaches to) a per-workspace Claude agent container.
#
#     ccc [-p prompt]
#
# -p  run claude as a single-shot prompt inside the container instead
#     of dropping into a shell

set -euo pipefail

# Parse arguments
PROMPT=""
while getopts ":p:" opt; do
    case "$opt" in
        p) PROMPT="$OPTARG" ;;
        \?) echo "Usage: $0 [-p prompt]" >&2; exit 1 ;;
        :) echo "Option -$OPTARG requires an argument" >&2; exit 1 ;;
    esac
done

source "$CLAUDE_DEVCONTAINER_HOME/devcontainer/scripts/lib/env.sh"

# Bootstrap files/dirs the container expects to already exist on the host.
[ -e "$HOME/.claude.json" ] || echo "{}" > "$HOME/.claude.json"
[ -e "$HOME/.netrc" ] || touch "$HOME/.netrc"

# Start the global singleton services - idempotent if already running.
# shellcheck disable=SC2086
$COMPOSE_CMD -f "$COMPOSE_FILE" up $COMPOSE_UP_FLAGS

# Create/start the workspace-scoped agent container - idempotent if already running.
# shellcheck disable=SC2086
$COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" up -d $COMPOSE_UP_FLAGS

# Bring the container's config/tooling up to date
$COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" exec agent /home/dev/provision.sh

# Exec a shell in the agent container or run claude as a single-shot prompt with -p
if [ -n "$PROMPT" ]; then
    exec $COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" exec agent claude -p "$PROMPT"
else
    exec $COMPOSE_CMD -p "$AGENT_COMPOSE_PROJECT_NAME" -f "$AGENT_COMPOSE_FILE" exec agent bash
fi
